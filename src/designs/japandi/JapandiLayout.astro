---
import DocumentHead from '../shared/DocumentHead.astro';

const FONT_STYLESHEET =
  'https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap';
---

<!doctype html>
<html lang="en" data-design="japandi">
  <head>
    <DocumentHead fontStylesheetUrl={FONT_STYLESHEET} themeColor="#F2EDE4" />
  </head>
  <body>
    <slot />
    <slot name="overlay" />
  </body>
</html>

<style is:global>
  html[data-design='japandi'] {
    --paper: #f2ede4;
    --paper-raised: #f8f5ef;
    --ink: #2e2a25;
    --ink-soft: #625b52;
    --ink-faint: #958b80;
    --oak: #b08a64;
    --oak-light: #dcc8ab;
    --walnut: #6e4f36;
    --sage: #7c8a6e;
    --sage-deep: #56664a;
    --sage-mist: #e2e5d8;
    --line: #e1d8ca;
    --font-display: 'Shippori Mincho', 'Hiragino Mincho ProN', Georgia, serif;
    --font-body: 'Zen Kaku Gothic New', 'Hiragino Sans', system-ui, sans-serif;

    scroll-behavior: smooth;
    scroll-padding-top: 5.5rem;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }

  :where(html[data-design='japandi']) :where(*, *::before, *::after) {
    box-sizing: border-box;
  }

  :where(html[data-design='japandi']) :where(body) {
    margin: 0;
    line-height: 1.7;
  }

  :where(html[data-design='japandi']) :where(h1, h2, h3, p, ol, ul, figure) {
    margin: 0;
  }

  :where(html[data-design='japandi']) :where(a) {
    color: inherit;
    text-decoration: none;
  }

  :where(html[data-design='japandi']) :where(img) {
    display: block;
    max-width: 100%;
  }

  :where(html[data-design='japandi']) ::selection {
    background: var(--sage-mist);
    color: var(--ink);
  }
</style>
