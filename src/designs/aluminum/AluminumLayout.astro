---
import DocumentHead from '../shared/DocumentHead.astro';

const FONT_STYLESHEET =
  'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap';
---

<!doctype html>
<html lang="en" data-design="aluminum">
  <head>
    <DocumentHead fontStylesheetUrl={FONT_STYLESHEET} themeColor="#FBFBFD" />
  </head>
  <body>
    <slot />
    <slot name="overlay" />
  </body>
</html>

<style is:global>
  html[data-design='aluminum'] {
    --canvas: #fbfbfd;
    --canvas-alt: #f5f5f7;
    --tile: #ffffff;
    --ink: #1d1d1f;
    --ink-soft: #6e6e73;
    --ink-faint: #86868b;
    --hairline: #d2d2d7;
    --link: #0066cc;
    --link-hover: #0077ed;
    --font-system:
      -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Inter', 'Helvetica Neue',
      sans-serif;

    scroll-behavior: smooth;
    scroll-padding-top: 3.5rem;
    background: var(--canvas);
    color: var(--ink);
    font-family: var(--font-system);
    -webkit-font-smoothing: antialiased;
  }

  :where(html[data-design='aluminum']) :where(*, *::before, *::after) {
    box-sizing: border-box;
  }

  :where(html[data-design='aluminum']) :where(body) {
    margin: 0;
    line-height: 1.47;
    letter-spacing: -0.01em;
  }

  :where(html[data-design='aluminum']) :where(h1, h2, h3, p, ol, ul) {
    margin: 0;
  }

  :where(html[data-design='aluminum']) :where(a) {
    color: inherit;
    text-decoration: none;
  }

  :where(html[data-design='aluminum']) :where(img) {
    display: block;
    max-width: 100%;
  }

  :where(html[data-design='aluminum']) ::selection {
    background: #b3d7ff;
  }
</style>
