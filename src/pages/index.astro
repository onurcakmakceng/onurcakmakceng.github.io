---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site.config';
import SectionHeader from '../components/SectionHeader';
import ProjectCard from '../components/ProjectCard';
import MediumPosts from '../components/MediumPosts';
import CareerTimeline from '../components/CareerTimeline';
import SiteMenu from '../components/SiteMenu';
import { GitHubIcon, LinkedInIcon } from '../components/icons';

const MENU_LINKS = [
  { href: '#experience', label: 'Experience' },
  { href: '#bookmarks', label: 'Bookmarks' },
  { href: '#projects', label: 'Open Source & Side Projects' },
  { href: '#articles', label: 'Articles' },
] as const;
---

<Layout title={SITE.title} description={SITE.description}>
  <div id="top" class="max-w-[1100px] mx-auto px-6 relative z-10">
    <nav
      class="sticky top-0 z-50 -mx-6 px-6 py-4 flex items-center justify-between bg-[#18181c]/80 backdrop-blur-md"
    >
      <a href="#top" class="hidden md:inline gradient-text text-xl font-bold tracking-tight"
        >{SITE.name}</a
      >
      <div class="ml-auto">
        <SiteMenu
          client:load
          links={MENU_LINKS}
          linkedinUrl={SITE.social.linkedin}
          githubUrl={SITE.social.github}
        />
      </div>
    </nav>

    <section class="pt-8 md:pt-20 pb-16">
      <div class="flex flex-col md:flex-row md:items-center gap-10 max-w-[780px]">
        <img
          src={SITE.avatarUrl}
          alt={SITE.author.name}
          width="120"
          height="120"
          class="rounded-2xl border-2 border-[#2e2e3a] shrink-0 w-[96px] h-[96px] md:w-[120px] md:h-[120px] object-cover"
        />
        <div>
          <h1 class="text-[clamp(2.2rem,5vw,3.4rem)] font-bold leading-[1.1] mb-4">
            <span class="gradient-text">{SITE.author.name}</span>
          </h1>
          <p class="text-lg text-slate-400 leading-relaxed mb-6">
            Senior Software Engineer with 8+ years of experience, specializing in Back-End
            technologies. Expertise in Java, Python, C#, Cloud Technologies alongside hands-on
            experience in React and Unity. Focused on delivering quality and the best products for
            people. Motivated by seeing users.
          </p>
          <div class="flex gap-3 flex-wrap">
            <a
              href={SITE.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-medium bg-[#26262e] border border-[#2e2e3a] text-slate-100 hover:bg-[#202027] hover:border-[var(--color-accent)] transition-all"
            >
              <LinkedInIcon size={15} />
              LinkedIn
            </a>
            <a
              href={SITE.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-medium bg-[#26262e] border border-[#2e2e3a] text-slate-100 hover:bg-[#202027] hover:border-[var(--color-accent)] transition-all"
            >
              <GitHubIcon size={15} />
              GitHub
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-14 border-t border-[#2e2e3a]" id="experience">
      <SectionHeader
        title="Experience"
        linkHref={SITE.social.linkedin}
        linkText="Full profile"
        linkIcon={LinkedInIcon}
        description="8+ years building software across defense, gaming, e-commerce, and AI, from early-stage startups to scale-ups, unicorns, and decacorns."
      />
      <CareerTimeline entries={SITE.career} />
    </section>

    <section class="py-14 border-t border-[#2e2e3a]" id="bookmarks">
      <SectionHeader
        title="Bookmarks"
        description="Links I've saved: CS fundamentals, tools, games, and more."
      />
      <div class="rounded-2xl overflow-hidden border border-[#2e2e3a] bg-[#202027]">
        <iframe
          class="block w-full h-[420px] lg:h-[620px]"
          style="border:0;"
          allowfullscreen
          frameborder="0"
          src="https://onurcakmakcs.raindrop.page/embed/me"
          loading="lazy"></iframe>
      </div>
    </section>

    <section class="py-14 border-t border-[#2e2e3a]" id="projects">
      <SectionHeader title="Open Source & Side Projects" />
      <div class="grid grid-cols-[repeat(auto-fill,minmax(300px,380px))] gap-5">
        {SITE.projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="py-14 border-t border-[#2e2e3a]" id="articles">
      <SectionHeader title="Articles" linkHref={SITE.social.medium} linkText="All on Medium →" />
      <MediumPosts client:load />
    </section>

    <footer class="py-10 border-t border-[#2e2e3a]">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
        <p class="text-slate-500 text-sm">{SITE.author.copyright}</p>
        <div class="flex gap-6">
          <a
            href={SITE.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-slate-100 transition-colors text-sm">LinkedIn</a
          >
          <a
            href={SITE.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-slate-100 transition-colors text-sm">GitHub</a
          >
          <a
            href={SITE.social.medium}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-slate-100 transition-colors text-sm">Medium</a
          >
        </div>
      </div>
    </footer>
  </div>
</Layout>
